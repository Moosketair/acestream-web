# Rotate any WireGuard key that has ever been disclosed. Never commit .env.
WIREGUARD_PRIVATE_KEY=REPLACE_WITH_NEW_WIREGUARD_PRIVATE_KEY
# At least 24 random characters, preferably 32+ (python -c "import secrets; print(secrets.token_urlsafe(32))")
SETUP_TOKEN=REPLACE_WITH_RANDOM_LONG_SETUP_TOKEN
# Bind on a trusted LAN address or localhost if exposed via a reverse proxy.
WEB_BIND_IP=0.0.0.0
WEB_PORT=8087
# For HTTPS reverse-proxy access, set to true.
COOKIE_SECURE=false
MAX_STREAMS=3
# Keep the previous DNS override if required:
ACESTREAM_DNS_FILE=./config/resolv.conf
